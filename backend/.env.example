# ZWY项目管理系统 - 环境配置模板
# 复制此文件为 .env 并修改相应配置

# 数据库配置
DATABASE_URL=sqlite:///./zwy_project.db

# JWT 安全配置
JWT_SECRET_KEY=your-jwt-secret-key-will-be-auto-generated
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 管理员账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-will-be-auto-generated

# 应用配置  
DEBUG=False
UPLOAD_DIR=uploads

# 内网部署配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000